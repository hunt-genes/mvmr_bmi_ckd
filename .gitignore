# ---- input data never goes in git ----
data/raw/*
!data/raw/README.md
!data/raw/.gitkeep

# ---- generated outputs (regenerated by the scripts) ----
data/processed/*
!data/processed/.gitkeep
results/*
!results/.gitkeep
figures/*
!figures/.gitkeep

# ---- R / OS cruft ----
.Rproj.user
.Rhistory
.RData
.Ruserdata
*.Rproj
.DS_Store
